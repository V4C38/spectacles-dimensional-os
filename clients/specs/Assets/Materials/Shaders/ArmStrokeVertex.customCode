input_float PointDelta00;
input_float PointDelta01;
input_float PointDelta02;
input_float PointDelta10;
input_float PointDelta11;
input_float PointDelta12;
input_float PointDelta20;
input_float PointDelta21;
input_float PointDelta22;
input_float PointDeltaX;
input_float PointDeltaY;
input_float PointDeltaZ;
input_float PointFloor;
input_float PointBoost;
input_float PointVisibility;
output_float PointOpacity;
// Static local points and transform differences are in Specs centimetres.
float armPointOpacity(vec3 p) {
    vec3 displacement = vec3(
        dot(vec3(PointDelta00, PointDelta01, PointDelta02), p) + PointDeltaX,
        dot(vec3(PointDelta10, PointDelta11, PointDelta12), p) + PointDeltaY,
        dot(vec3(PointDelta20, PointDelta21, PointDelta22), p) + PointDeltaZ);
    float t = clamp((length(displacement) - 0.5) / 9.5, 0.0, 1.0);
    float weight = t * t * (3.0 - 2.0 * t);
    return PointVisibility * (PointFloor + max(0.0, weight - PointFloor) * PointBoost);
}
input_float PositionX;
input_float PositionY;
input_float PositionZ;
input_float RotationX;
input_float RotationY;
input_float RotationZ;
input_float RotationW;
input_float WidthScale;
vec3 armWorld(vec3 p) {
    vec3 q = vec3(RotationX, RotationY, RotationZ);
    return p + 2.0 * cross(q, cross(q, p) + RotationW * p) + vec3(PositionX, PositionY, PositionZ);
}
input_float ViewportHeightPx;
input_float NearWidthScale;
input_float MinimumPixels;
void strokeMetrics(out vec3 a, out vec3 b, out vec3 p, out vec2 normal,
                   out vec2 viewport, out float pixelCm, out float halfWidth) {
    vec2 uv0 = system.getSurfaceUVCoord0();
    vec2 uv1 = system.getSurfaceUVCoord1();
    vec2 uv2 = system.getSurfaceUVCoord2();
    vec2 uv3 = system.getSurfaceUVCoord3();
    vec2 uv4 = system.getSurfaceUVCoord4();
    vec2 uv5 = system.getSurfaceUVCoord5();
    // armWorld already applies the link pose; exclude the object's model matrix.
    mat4 view = system.getMatrixView();
    mat4 projection = system.getMatrixProjection();
    a = (view * vec4(armWorld(vec3(uv4.y, uv5.x, uv5.y)), 1.0)).xyz;
    b = (view * vec4(armWorld(vec3(uv1.x, uv1.y, uv2.x)), 1.0)).xyz;
    viewport = vec2(max(1.0, ViewportHeightPx) * abs(projection[1][1] / projection[0][0]), max(1.0, ViewportHeightPx));
    vec4 ca = projection * vec4(a, 1.0);
    vec4 cb = projection * vec4(b, 1.0);
    vec2 direction = (cb.xy / max(abs(cb.w), 0.01) - ca.xy / max(abs(ca.w), 0.01)) * viewport;
    normal = vec2(-direction.y, direction.x) / max(length(direction), 0.0001);
    p = mix(a, b, uv0.y);
    float factor = 2.0 / max(0.0001, abs(projection[1][1]) * viewport.y);
    float pixelA = factor * mix(1.0, max(0.1, -a.z), abs(projection[2][3]));
    float pixelB = factor * mix(1.0, max(0.1, -b.z), abs(projection[2][3]));
    pixelCm = mix(pixelA, pixelB, uv0.y);
    float widthA = max(uv3.x * WidthScale, MinimumPixels * pixelA);
    float widthB = max(uv3.x * WidthScale, MinimumPixels * pixelB);
    halfWidth = mix(widthA, widthB, uv0.y) * 0.5;
}
output_vec3 Position;
void main() {
    vec2 uv4 = system.getSurfaceUVCoord4();
    vec2 uv5 = system.getSurfaceUVCoord5();
    vec2 uv1 = system.getSurfaceUVCoord1();
    vec2 uv2 = system.getSurfaceUVCoord2();
    vec3 localPoint = mix(vec3(uv4.y, uv5.x, uv5.y), vec3(uv1.x, uv1.y, uv2.x), system.getSurfaceUVCoord0().y);
    PointOpacity = armPointOpacity(localPoint);
    vec3 a; vec3 b; vec3 p; vec2 normal; vec2 viewport; float pixelCm; float halfWidth;
    strokeMetrics(a, b, p, normal, viewport, pixelCm, halfWidth);
    vec4 clip = system.getMatrixProjection() * vec4(p, 1.0);
    clip.xy += normal * system.getSurfaceUVCoord0().x * (halfWidth / pixelCm + 1.0) * 2.0 / viewport * clip.w;
    vec4 world = system.getMatrixProjectionViewInverse() * clip;
    Position = world.xyz / world.w;
}
