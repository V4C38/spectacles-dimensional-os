input_float StartX;
input_float StartY;
input_float StartZ;
input_float ControlX;
input_float ControlY;
input_float ControlZ;
input_float EndX;
input_float EndY;
input_float EndZ;
input_float Radius;
input_float TipRadius;
output_vec3 Position;
void main() {
    vec2 uv = system.getSurfaceUVCoord0();
    float t = uv.y, u = 1.0 - t;
    vec3 control = vec3(ControlX, ControlY, ControlZ);
    vec3 end = vec3(EndX, EndY, EndZ);
    vec3 center = 2.0 * u * t * control + t * t * end;
    vec3 tangent = normalize(2.0 * u * control + 2.0 * t * (end - control) + vec3(0.0, 0.0, 0.000001));
    vec3 reference = abs(tangent.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 side = normalize(cross(tangent, reference));
    vec3 up = cross(tangent, side);
    float angle = uv.x * 6.28318530718;
    float taper = smoothstep(0.0, 5.0, length(center));
    vec3 local = center + (side * cos(angle) + up * sin(angle)) * mix(Radius, TipRadius, t) * taper;
    Position = local + vec3(StartX, StartY, StartZ);
}
