# Git LFS — large binaries (install: git lfs install)

# README / demo media
assets/** filter=lfs diff=lfs merge=lfs -text
assets/**/*.py !filter !diff !merge text

# Lens Studio LFS and merge rules live in clients/specs/.gitattributes

# Native generator templates are binary tooling inputs, outside shipped Lens assets.
clients/specs/tools/shaders/templates/*.ss_graph binary
